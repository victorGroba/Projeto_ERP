generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODELOS DE INGESTÃO VIA CSV (ETL)
// ==========================================

model Lancamento {
  id            String   @id @default(uuid())
  tipo          String   @default("DESPESA") // "RECEITA" ou "DESPESA"
  descricao     String?
  categoria     String?
  centroDeCusto String?
  contaBancaria String?  // p.ex: BB, XP, BTG
  dataPagamento DateTime
  valor         Float
  fornecedor    String?
  createdAt     DateTime @default(now())

  importacaoId  String?
  importacao    HistoricoImportacao? @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
}

model ContaReceber {
  id              String   @id @default(uuid())
  clienteId       String?  // UUID da pessoa na Conta Azul; permite cruzar com o cadastro sem depender do nome
  cliente         String
  grupo           String?  // Agrupar clientes do mesmo grupo econômico (ex: franquias)
  categoria       String?  // Tipo da receita (Serviços, Financeira, Venda Veículo...)
  dataCompetencia DateTime?
  dataVencimento  DateTime
  valor           Float
  valorTotal      Float?   // Valor original do titulo (faturamento bruto)
  valorPago       Float?   // Parcela ja recebida, inclusive pagamentos parciais
  valorAberto     Float?   // Saldo ainda nao recebido
  status          String   // Vencido, A Vencer, Recebido
  descricao       String?
  numeroNotaFiscal String?
  createdAt       DateTime @default(now())

  importacaoId    String?
  importacao      HistoricoImportacao? @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

// Espelho do cadastro de Pessoas da Conta Azul. O `codigo` e a chave de negocio
// usada para reunir CNPJs/nomes diferentes que pertencem ao mesmo grupo.
model ClienteContaAzul {
  id                String   @id
  codigo            String?
  nome              String
  nomeEmpresa       String?
  documento         String?
  email             String?
  telefoneCelular   String?
  telefoneComercial String?
  cidade            String?
  uf                String?
  tipoPessoa        String?
  ativo             Boolean  @default(true)
  criadoEm          DateTime?
  alteradoEm        DateTime?
  sincronizadoEm    DateTime @default(now())

  @@index([codigo])
  @@index([nome])
  @@index([documento])
}

model SaldoBancario {
  id          String   @id @default(uuid())
  instituicao String
  saldo       Float
  data        DateTime
  createdAt   DateTime @default(now())
}

// Armazena tokens OAuth e outras configurações persistentes
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Modelo para rastreio de importações
model HistoricoImportacao {
  id            String   @id @default(uuid())
  tipo          String   // "DESPESAS" ou "RECEITAS"
  arquivoNome   String?
  dataInicio    DateTime?
  dataFim       DateTime?
  qtdRegistros  Int
  createdAt     DateTime @default(now())
  
  lancamentos   Lancamento[]
  contasReceber ContaReceber[]
}
