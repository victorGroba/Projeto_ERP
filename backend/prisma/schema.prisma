generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODELOS DE INGESTÃO VIA CSV (ETL)
// ==========================================

model Lancamento {
  id            String   @id @default(uuid())
  tipo          String   @default("DESPESA") // "RECEITA" ou "DESPESA"
  descricao     String?
  categoria     String?
  centroDeCusto String?
  contaBancaria String?  // p.ex: BB, XP, BTG
  dataPagamento DateTime
  valor         Float
  fornecedor    String?
  createdAt     DateTime @default(now())

  importacaoId  String?
  importacao    HistoricoImportacao? @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
}

model ContaReceber {
  id              String   @id @default(uuid())
  clienteId       String?  // UUID da pessoa na Conta Azul; permite cruzar com o cadastro sem depender do nome
  cliente         String
  grupo           String?  // Agrupar clientes do mesmo grupo econômico (ex: franquias)
  categoria       String?  // Tipo da receita (Serviços, Financeira, Venda Veículo...)
  dataCompetencia DateTime?
  dataVencimento  DateTime
  valor           Float
  valorTotal      Float?   // Valor original do titulo (faturamento bruto)
  valorPago       Float?   // Parcela ja recebida, inclusive pagamentos parciais
  valorAberto     Float?   // Saldo ainda nao recebido
  status          String   // Vencido, A Vencer, Recebido
  descricao       String?
  numeroNotaFiscal String?
  createdAt       DateTime @default(now())

  importacaoId    String?
  importacao      HistoricoImportacao? @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

// Espelho do cadastro de Pessoas da Conta Azul. O `codigo` e a chave de negocio
// usada para reunir CNPJs/nomes diferentes que pertencem ao mesmo grupo.
model ClienteContaAzul {
  id                String   @id
  codigo            String?
  nome              String
  nomeEmpresa       String?
  documento         String?
  email             String?
  telefoneCelular   String?
  telefoneComercial String?
  cidade            String?
  uf                String?
  tipoPessoa        String?
  ativo             Boolean  @default(true)
  criadoEm          DateTime?
  alteradoEm        DateTime?
  sincronizadoEm    DateTime @default(now())

  @@index([codigo])
  @@index([nome])
  @@index([documento])
}

// Fechamento fiscal mensal importado do portal da prefeitura. Esta e a fonte
// oficial do faturamento bruto de servicos; o financeiro do Conta Azul segue
// sendo usado para recebido, aberto e inadimplencia.
model ImportacaoFiscal {
  id                  String              @id @default(uuid())
  competencia         DateTime            @unique
  arquivoNome         String
  qtdNotas             Int
  valorTotal           Float
  qtdNaoConciliadas    Int                 @default(0)
  createdAt            DateTime            @default(now())
  notas                NotaFiscalServico[]
}

model NotaFiscalServico {
  id                  String            @id @default(uuid())
  importacaoId        String
  importacao          ImportacaoFiscal  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  numero              String
  prestadorDocumento  String
  clienteDocumento    String
  clienteNome         String
  dataEmissao         DateTime
  dataCompetencia     DateTime
  valorBruto          Float
  // Retencoes federais informadas pela propria NFS-e (colunas "Valor CSLL" e
  // "Valor IR" do layout da prefeitura). Faturamento liquido = valorBruto -
  // (valorCSLL + valorIR); o ISS fica de fora por decisao do financeiro, pois
  // normalmente e pago via guia separada, nao retido pelo tomador.
  valorCSLL           Float             @default(0)
  valorIR             Float             @default(0)
  // Texto livre da nota ("Discriminacao dos Servicos"). Uma mesma nota pode
  // descrever varios servicos distintos separados por "|"; o detalhamento
  // fica em `itens`.
  descricaoServico    String?
  createdAt           DateTime          @default(now())
  itens               ItemNotaFiscal[]

  @@unique([prestadorDocumento, numero])
  @@index([dataCompetencia])
  @@index([clienteDocumento])
  @@index([clienteNome])
}

// Um servico/exame dentro da discriminacao de uma nota, extraido por parsing
// de texto livre (ex: "Swab 3 parametros - R$ 122,00  8  R$ 976,00"). Quando a
// nota nao segue esse padrao, grava um unico item com `estruturado = false` e
// valorTotal = valorBruto da nota, para nao perder o valor da analise de
// composicao de vendas.
model ItemNotaFiscal {
  id                   String            @id @default(uuid())
  notaId               String
  nota                 NotaFiscalServico @relation(fields: [notaId], references: [id], onDelete: Cascade)
  descricao            String
  descricaoNormalizada String
  quantidade           Float
  valorUnitario        Float?
  valorTotal           Float
  estruturado          Boolean           @default(true)

  @@index([notaId])
  @@index([descricaoNormalizada])
}

model SaldoBancario {
  id          String   @id @default(uuid())
  instituicao String
  saldo       Float
  data        DateTime
  createdAt   DateTime @default(now())
}

// NFS-e lidas da API do Conta Azul (GET /v1/notas-fiscais-servico), varias
// vezes ao dia. Complementa o CSV da prefeitura (NotaFiscalServico), que so
// chega no fechamento do mes: notas emitidas depois da exportacao do CSV e
// cancelamentos aparecem aqui antes. O valor da API e o LIQUIDO das retencoes
// federais (conferido em set/2026: 93,85% ou 98,5% do bruto do CSV), por isso
// nao se mistura com `valorBruto`. `id` e o UUID da nota no Conta Azul.
model NotaFiscalServicoApi {
  id                String    @id
  numero            String
  status            String
  valorLiquido      Float
  dataCompetencia   DateTime
  dataEmissao       DateTime?
  clienteNome       String
  clienteDocumento  String
  numeroVenda       String?
  cidadeEmissao     String?
  ufEmissao         String?
  atualizadoEm      DateTime  @updatedAt

  @@index([dataCompetencia])
  @@index([numero])
}

// Armazena tokens OAuth e outras configurações persistentes
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Modelo para rastreio de importações
model HistoricoImportacao {
  id            String   @id @default(uuid())
  tipo          String   // "DESPESAS" ou "RECEITAS"
  arquivoNome   String?
  dataInicio    DateTime?
  dataFim       DateTime?
  qtdRegistros  Int
  createdAt     DateTime @default(now())
  
  lancamentos   Lancamento[]
  contasReceber ContaReceber[]
}

// ==========================================
// CUSTEIO DOS ENSAIOS (LABORATÓRIO)
// ==========================================

// Insumo das fichas técnicas. O preço não fica no cadastro: cada compra ou
// reajuste vira um InsumoPreco e o vigente é o de vigência mais recente,
// para o custo dos ensaios poder ser recalculado em qualquer data.
model Insumo {
  id         String        @id @default(uuid())
  chave      String        @unique // nome normalizado; evita duplicar ao reimportar a planilha
  nome       String
  unidade    String?       // unidade da quantidade da embalagem (g, mL, un...)
  categoria  String?
  setor      String?       // FQ ou MICRO
  ativo      Boolean       @default(true)
  pendencia  String?       // o que precisa ser conferido no cadastro
  observacao String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  precos     InsumoPreco[]
  fichaItens FichaItem[]
}

model InsumoPreco {
  id             String   @id @default(uuid())
  insumoId       String
  insumo         Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  precoEmbalagem Float
  qtdEmbalagem   Float
  precoUnitario  Float    // precoEmbalagem / qtdEmbalagem, na unidade do insumo
  vigencia       DateTime
  fornecedor     String?
  origem         String?  // "Manual" ou o arquivo importado
  createdAt      DateTime @default(now())

  @@index([insumoId, vigencia])
}

// Equipamentos e calibrações amortizados no custo dos ensaios. Os valores são
// tabelados, por isso ficam direto no cadastro, sem histórico.
model Equipamento {
  id            String   @id @default(uuid())
  chave         String   @unique
  nome          String
  tipo          String   @default("EQUIPAMENTO") // EQUIPAMENTO ou CALIBRACAO
  setor         String?
  valor         Float?
  vidaUtilMeses Int?     // prazo de amortização; na calibração é a periodicidade
  diasUsoMes    Int?
  ativo         Boolean  @default(true)
  pendencia     String?
  observacao    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fichaItens    FichaItem[]
}

// Ensaio com a ficha técnica. O custo não é gravado: é calculado a partir dos
// itens da ficha com os preços vigentes, então muda sozinho quando um insumo
// é reajustado.
model Ensaio {
  id            String      @id @default(uuid())
  chave         String      @unique
  nome          String
  codigoLims    String?
  metodologia   String?
  setor         String?     // FQ ou MICRO
  percentualCQ  Float       @default(0) // controle de qualidade (branco, padrão, duplicata) sobre o custo
  custoPlanilha Float?      // custo que a planilha de referência apontava, para comparação
  origem        String?     // aba da planilha de onde a ficha veio
  ativo         Boolean     @default(true)
  pendencia     String?
  observacao    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  itens         FichaItem[]
  gruposVenda   GrupoEnsaio[]
}

// Linha da ficha técnica. "rendimento" é quantas análises a linha atende:
// atividade feita em lote, solução preparada que serve várias análises ou, no
// equipamento, quantas análises por dia dividem o custo diário.
model FichaItem {
  id            String       @id @default(uuid())
  ensaioId      String
  ensaio        Ensaio       @relation(fields: [ensaioId], references: [id], onDelete: Cascade)
  ordem         Int          @default(0)
  tipo          String       // ATIVIDADE, INSUMO ou EQUIPAMENTO
  descricao     String?      // nome da atividade
  grupo         String?      // solução preparada ou etapa a que o insumo pertence
  minutos       Float?
  insumoId      String?
  insumo        Insumo?      @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  quantidade    Float?       // na unidade do insumo
  equipamentoId String?
  equipamento   Equipamento? @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  vidaUtilMeses Float?       // sobrepõe a vida útil do cadastro do equipamento
  rendimento    Float        @default(1)

  @@index([ensaioId])
  @@index([insumoId])
  @@index([equipamentoId])
}

// Parâmetros gerais do custeio (custo do minuto do técnico, dias úteis,
// alíquota de impostos...). Lançamento manual — financeiro/Daniel atualiza.
model ParametroCusto {
  chave     String   @id
  valor     Float
  descricao String?
  updatedAt DateTime @updatedAt
}

// Serviço vendido ao cliente (catálogo comercial do laboratório). Um serviço
// pode se dividir em mais de um grupo com preço próprio (ex.: "Água de Rede"
// vende um grupo Físico-Químico e um grupo Microbiológico separadamente).
model Servico {
  id         String           @id @default(uuid())
  chave      String           @unique
  nome       String
  codigo     String?          // referência do catálogo de origem (ex.: "Serviço 01")
  ativo      Boolean          @default(true)
  observacao String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  grupos     GrupoAnalitico[]
}

// Unidade de venda de fato: tem preço próprio e reúne os ensaios que o
// cliente recebe por esse preço. A margem de contribuição é calculada aqui
// (preço − imposto − soma do custo direto dos ensaios do grupo), não no
// Servico nem no Ensaio isolado.
model GrupoAnalitico {
  id         String        @id @default(uuid())
  servicoId  String
  servico    Servico       @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  nome       String
  setor      String?       // FQ ou MICRO
  precoVenda Float
  nomeAllims String?       // de-para manual com o nome do serviço no Allims (preenchido depois, com o Daniel)
  pendencia  String?       // ex.: parâmetro da planilha de origem sem ensaio correspondente no cadastro
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  ensaios    GrupoEnsaio[]

  @@index([servicoId])
}

model GrupoEnsaio {
  id       String         @id @default(uuid())
  grupoId  String
  grupo    GrupoAnalitico @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  ensaioId String
  ensaio   Ensaio         @relation(fields: [ensaioId], references: [id], onDelete: Restrict)

  @@unique([grupoId, ensaioId])
  @@index([ensaioId])
}
