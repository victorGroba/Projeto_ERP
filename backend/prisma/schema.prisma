generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODELOS DE INGESTÃO VIA CSV (ETL)
// ==========================================

model Lancamento {
  id            String   @id @default(uuid())
  tipo          String   @default("DESPESA") // "RECEITA" ou "DESPESA"
  descricao     String?
  categoria     String?
  centroDeCusto String?
  contaBancaria String?  // p.ex: BB, XP, BTG
  dataPagamento DateTime
  valor         Float
  fornecedor    String?
  createdAt     DateTime @default(now())

  importacaoId  String?
  importacao    HistoricoImportacao? @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
}

model ContaReceber {
  id              String   @id @default(uuid())
  clienteId       String?  // UUID da pessoa na Conta Azul; permite cruzar com o cadastro sem depender do nome
  cliente         String
  grupo           String?  // Agrupar clientes do mesmo grupo econômico (ex: franquias)
  categoria       String?  // Tipo da receita (Serviços, Financeira, Venda Veículo...)
  dataCompetencia DateTime?
  dataVencimento  DateTime
  valor           Float
  valorTotal      Float?   // Valor original do titulo (faturamento bruto)
  valorPago       Float?   // Parcela ja recebida, inclusive pagamentos parciais
  valorAberto     Float?   // Saldo ainda nao recebido
  status          String   // Vencido, A Vencer, Recebido
  descricao       String?
  numeroNotaFiscal String?
  createdAt       DateTime @default(now())

  importacaoId    String?
  importacao      HistoricoImportacao? @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

// Espelho do cadastro de Pessoas da Conta Azul. O `codigo` e a chave de negocio
// usada para reunir CNPJs/nomes diferentes que pertencem ao mesmo grupo.
model ClienteContaAzul {
  id                String   @id
  codigo            String?
  nome              String
  nomeEmpresa       String?
  documento         String?
  email             String?
  telefoneCelular   String?
  telefoneComercial String?
  cidade            String?
  uf                String?
  tipoPessoa        String?
  ativo             Boolean  @default(true)
  criadoEm          DateTime?
  alteradoEm        DateTime?
  sincronizadoEm    DateTime @default(now())

  @@index([codigo])
  @@index([nome])
  @@index([documento])
}

// Fechamento fiscal mensal importado do portal da prefeitura. Esta e a fonte
// oficial do faturamento bruto de servicos; o financeiro do Conta Azul segue
// sendo usado para recebido, aberto e inadimplencia.
model ImportacaoFiscal {
  id                  String              @id @default(uuid())
  competencia         DateTime            @unique
  arquivoNome         String
  qtdNotas             Int
  valorTotal           Float
  qtdNaoConciliadas    Int                 @default(0)
  createdAt            DateTime            @default(now())
  notas                NotaFiscalServico[]
}

model NotaFiscalServico {
  id                  String            @id @default(uuid())
  importacaoId        String
  importacao          ImportacaoFiscal  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  numero              String
  prestadorDocumento  String
  clienteDocumento    String
  clienteNome         String
  dataEmissao         DateTime
  dataCompetencia     DateTime
  valorBruto          Float
  createdAt           DateTime          @default(now())

  @@unique([prestadorDocumento, numero])
  @@index([dataCompetencia])
  @@index([clienteDocumento])
  @@index([clienteNome])
}

model SaldoBancario {
  id          String   @id @default(uuid())
  instituicao String
  saldo       Float
  data        DateTime
  createdAt   DateTime @default(now())
}

// Armazena tokens OAuth e outras configurações persistentes
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Modelo para rastreio de importações
model HistoricoImportacao {
  id            String   @id @default(uuid())
  tipo          String   // "DESPESAS" ou "RECEITAS"
  arquivoNome   String?
  dataInicio    DateTime?
  dataFim       DateTime?
  qtdRegistros  Int
  createdAt     DateTime @default(now())
  
  lancamentos   Lancamento[]
  contasReceber ContaReceber[]
}

// ==========================================
// CUSTEIO DOS ENSAIOS (LABORATÓRIO)
// ==========================================

// Insumo das fichas técnicas. O preço não fica no cadastro: cada compra ou
// reajuste vira um InsumoPreco e o vigente é o de vigência mais recente,
// para o custo dos ensaios poder ser recalculado em qualquer data.
model Insumo {
  id         String        @id @default(uuid())
  chave      String        @unique // nome normalizado; evita duplicar ao reimportar a planilha
  nome       String
  unidade    String?       // unidade da quantidade da embalagem (g, mL, un...)
  categoria  String?
  setor      String?       // FQ ou MICRO
  ativo      Boolean       @default(true)
  pendencia  String?       // o que precisa ser conferido no cadastro
  observacao String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  precos     InsumoPreco[]
}

model InsumoPreco {
  id             String   @id @default(uuid())
  insumoId       String
  insumo         Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  precoEmbalagem Float
  qtdEmbalagem   Float
  precoUnitario  Float    // precoEmbalagem / qtdEmbalagem, na unidade do insumo
  vigencia       DateTime
  fornecedor     String?
  origem         String?  // "Manual" ou o arquivo importado
  createdAt      DateTime @default(now())

  @@index([insumoId, vigencia])
}

// Equipamentos e calibrações amortizados no custo dos ensaios. Os valores são
// tabelados, por isso ficam direto no cadastro, sem histórico.
model Equipamento {
  id            String   @id @default(uuid())
  chave         String   @unique
  nome          String
  tipo          String   @default("EQUIPAMENTO") // EQUIPAMENTO ou CALIBRACAO
  setor         String?
  valor         Float?
  vidaUtilMeses Int?     // prazo de amortização; na calibração é a periodicidade
  diasUsoMes    Int?
  ativo         Boolean  @default(true)
  pendencia     String?
  observacao    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
